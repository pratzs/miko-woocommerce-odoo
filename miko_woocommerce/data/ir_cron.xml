<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- numbercall and doall are deliberately absent: Odoo 18 removed both
             from ir.cron, so naming them breaks this file on 18 and 19.

             Active, but _cron_woo_sync only touches channels whose owner turned
             auto_sync on, and that defaults to off. Installing moves no data. -->
        <record id="cron_woo_sync" model="ir.cron">
            <field name="name">WooCommerce: scheduled sync</field>
            <field name="model_id" ref="miko_ecommerce_core.model_miko_ecommerce_channel"/>
            <field name="state">code</field>
            <field name="code">model._cron_woo_sync()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
